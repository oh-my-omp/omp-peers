{
	"name": "omp-peers",
	"version": "1.0.0",
	"description": "Lets the omp main sessions of one user, in any folder, find each other through peer://, ask side questions and exchange messages across processes",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oh-my-omp/omp-peers.git"
	},
	"files": [
		"index.ts",
		"src",
		"omomp-shared",
		"CHANGELOG.md"
	],
	"omomp": {
		"changelog": "CHANGELOG.md"
	},
	"omp": {
		"extensions": [
			"./index.ts"
		],
		"settings": {
			"enabled": {
				"type": "boolean",
				"default": true,
				"description": "Open this omp's peer endpoint and offer peer:// to its sessions; a change takes effect when omp next starts"
			}
		}
	},
	"scripts": {
		"check": "biome check . && tsc --noEmit",
		"format": "biome check --write .",
		"test": "bun test"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-agent-core": "*",
		"@oh-my-pi/pi-coding-agent": "*",
		"@oh-my-pi/pi-natives": "*",
		"@oh-my-pi/pi-utils": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@oh-my-pi/pi-agent-core": "latest",
		"@oh-my-pi/pi-coding-agent": "latest",
		"@oh-my-pi/pi-natives": "latest",
		"@oh-my-pi/pi-utils": "latest",
		"@types/bun": "latest",
		"typescript": "latest"
	}
}
