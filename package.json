{
	"name": "omp-peers",
	"version": "0.1.1",
	"description": "Lets the omp main agents of one user find each other, ask /btw-style side questions and exchange IRC messages across processes",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oh-my-omp/omp-peers.git"
	},
	"files": [
